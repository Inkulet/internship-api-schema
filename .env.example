# PostgreSQL — используется и postgres-образом для инициализации БД,
# и Rails-приложением для подключения (см. config/database.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_development

# Хост БД для Rails. В docker-compose это имя сервиса БД.
DB_HOST=db
DB_PORT=5432

# Соль для генерации auth_token студентов (sha256(user_id + SECRET_SALT)).
# В рабочем окружении замени на случайную строку.
SECRET_SALT=please-change-me-to-a-random-string

# Rails — режим работы.
RAILS_ENV=development
